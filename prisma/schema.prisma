// Prisma Schema para Plataforma Imobiliária Premium
// Compatível com SQLite (desenvolvimento local sem fricção)
// e PostgreSQL (Supabase / Neon para deploy gratuito em produção)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("BROKER") // "ADMIN" | "BROKER"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brokerProfile Broker?
}

model Broker {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String
  whatsapp    String   // Número limpo com DDI/DDD, ex: "5511999998888" para link direto
  creci       String
  photoUrl    String
  bio         String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties  Property[]
  leads       Lead[]
}

model Property {
  id            String   @id @default(uuid())
  code          String   @unique // Ex: "IMV-1001"
  title         String
  slug          String   @unique
  description   String
  type          String   // "CASA" | "APARTAMENTO" | "COBERTURA" | "TERRENO" | "COMERCIAL" | "FAZENDA" | "CHACARA" | "SOBRADO" | "CONDOMINIO"
  purpose       String   @default("VENDA") // "VENDA"
  price         Float
  condoFee      Float?
  propertyTax   Float?   // IPTU
  city          String
  state         String
  neighborhood  String
  address       String?
  number        String?
  zipCode       String?
  latitude      Float?
  longitude     Float?
  bedrooms      Int      @default(0)
  suites        Int      @default(0)
  bathrooms     Int      @default(0)
  parkingSpaces Int      @default(0)
  builtArea     Float    // Em m²
  totalArea     Float    // Em m²
  status        String   @default("PUBLICADO") // "RASCUNHO" | "PUBLICADO" | "RESERVADO" | "VENDIDO" | "INATIVO"
  isFeatured    Boolean  @default(false)
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brokerId      String?
  broker        Broker?  @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  images        PropertyImage[]
  features      PropertyFeature[]
  leads         Lead[]
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  isMain     Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model PropertyFeature {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String   // Ex: "Piscina de borda infinita"
  category   String?  // Ex: "Lazer", "Segurança", "Tecnologia"
}

model Lead {
  id         String    @id @default(uuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  brokerId   String?
  broker     Broker?   @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  name       String
  email      String
  phone      String
  message    String
  status             String    @default("NOVO") // "NOVO" | "EM_ATENDIMENTO" | "VISITA_AGENDADA" | "PROPOSTA" | "FECHADO" | "PERDIDO"
  source             String    @default("PORTAL")
  curatedPropertyIds String?   // Array JSON de IDs de imóveis sugeridos pelo corretor
  curatedNotes       String?   // Mensagem personalizada do corretor para o cliente
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SiteSetting {
  id           String   @id @default("default")
  name         String   @default("IMOBILIÁRIA")
  tagline      String   @default("Residências e Empreendimentos de Alto Padrão")
  logoText     String   @default("IMV")
  logoUrl      String?
  phone        String   @default("(11) 3045-8000")
  whatsapp     String   @default("5511999998888")
  email        String   @default("contato@imobiliaria.com.br")
  creciJ       String   @default("CRECI 00.000-J")
  street       String   @default("Avenida Principal, 1000")
  neighborhood String   @default("Centro")
  city         String   @default("São Paulo")
  state        String   @default("SP")
  zipCode      String   @default("01000-000")
  instagram    String   @default("https://instagram.com")

  // Personalização da Home (Hero, Textos, Frases e Imagens)
  heroBadge        String?  @default("Curadoria Imobiliária Exclusiva")
  heroTitle        String?  @default("Encontre o imóvel que combina com a sua próxima história.")
  heroSubtitle     String?  @default("Residências singulares, coberturas e refúgios contemporâneos selecionados com rigor arquitetônico e discrição inegociável.")
  heroBgImage      String?  @default("https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=2400&q=85")
  
  philosophyBadge  String?  @default("Nossa Filosofia")
  philosophyTitle  String?  @default("A arquitetura como expressão máxima do bem-viver.")
  philosophyText   String?  @default("Não comercializamos apenas metros quadrados. Representamos residências que inspiram, acolhem e valorizam o patrimônio das famílias mais exigentes com curadoria cirúrgica.")

  featuredTitle    String?  @default("Imóveis Selecionados")
  featuredSubtitle String?  @default("Coleção de residências notáveis que transcendem o convencional pela localização privilegiada e excelência construtiva.")

  // Personalização da Página Sobre
  aboutTitle        String?  @default("A Arte de Viver com Distinção")
  aboutSubtitle     String?  @default("Fundada sob a premissa de que uma residência transcende paredes e metragem: ela é o cenário onde vidas extraordinárias se desenrolam.")
  aboutHistoryTitle String?  @default("Curadoria Imobiliária Inspirada na Alta Arquitetura")
  aboutHistoryText1 String?  @default("Nascemos para atender um público que valoriza design atemporal, materiais nobres e privacidade inegociável. Nossa equipe não atua com volume indiscriminado de imóveis, mas com uma seleção criteriosa de casas com assinaturas prestigiadas, coberturas singulares e propriedades rurais com vocação para o lazer refinado.")
  aboutHistoryText2 String?  @default("Cada empreendimento inserido em nosso acervo passa por rigorosa auditoria jurídica e técnica, garantindo segurança patrimonial absoluta tanto para quem adquire quanto para quem aliena.")
  aboutImage        String?  @default("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

